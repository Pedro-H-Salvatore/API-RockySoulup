DB_URL=<jdbc:oracle:thin:@//host:port/service>
DB_USERNAME=<runtime_database_user>
DB_PASSWORD=<secret_from_secret_manager>
JWT_SECRET=<base64_of_at_least_32_cryptographically_random_bytes>
JWT_ISSUER=<https://issuer.example.invalid>
JWT_AUDIENCE=<rockysoulup-api-environment>
CORS_ALLOWED_ORIGINS=<https://frontend.example.invalid>
REQUIRE_HTTPS=<true_in_production_false_only_for_local_development>
# Offline provisioning only; remove these variables after use.
PROVISION_MODE=<bootstrap_or_activate>
PROVISION_NAME=<verified_person_name>
PROVISION_EMAIL=<verified_person_email>
PROVISION_PASSWORD=<unique_12_or_more_characters_at_most_72_utf8_bytes>
OPENAI_API_KEY=<backend_only_openai_key>
HIVE_API_KEY=<backend_only_hive_v3_key>
AI_ENABLED=false
# Veja config-examples/ai-local.properties.example para limites e custos.
