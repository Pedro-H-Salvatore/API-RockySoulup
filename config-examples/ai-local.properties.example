# Referência somente. Não importar este arquivo com placeholders como segredos.
# Acrescente as chaves ao arquivo PRIVADO config/local-secrets.properties.
GEMINI_API_KEY=<backend_only_gemini_key>
# Ativar somente após revisão/aplicação offline de V003 e conferência dos preços.
AI_ENABLED=false
AI_USER_MINUTE=2
AI_IP_MINUTE=5
AI_GLOBAL_MINUTE=10
AI_USER_DAILY=10
AI_GLOBAL_DAILY=100
AI_CONCURRENCY=2
AI_PENDING_LIMIT=100
AI_DAILY_MICROS=2000000
AI_MONTHLY_MICROS=20000000
AI_USER_DAILY_MICROS=500000
AI_GEMINI_CEILING_MICROS=110000
# Hipóteses de cálculo em micros USD / 1.000.000 tokens; conferir contrato atual.
AI_INPUT_MICROS_PER_MILLION=0
AI_OUTPUT_MICROS_PER_MILLION=0
AI_RETENTION_DAYS=7

# Somente Windows: true usa as raizes confiaveis do sistema, sem ignorar TLS.
AI_WINDOWS_TRUST_STORE=false
